! === Procedimento SST - define o modelo de apontamento a ser usado ===
! Apaga eventuais termos existentes no modelo do TPoint
! Seleciona os termos do modelo de apontamento:
!  - IA - erro de indexacao em azimute
!  - IE - erro de indexacao em azimute; cada feixe (canal) do SST tem um valor proprio
!  - TF - 
!  - NPAE - erro de nao-perpendicularidade entre os eixos de azimute e de elavacao
!  - CA - erro de colimação na direção esquerda-direita; cada feixe (canal) do SST tem um valor proprio
!  - AN - desalinhamento do eixo de azimute na direcao N-S
!  - AW - desalinhamento do eixo de azimute na direcao E-W

PROC SST  (Modelo atual do SST - 212 e 405 GHz - CRAAM Out2022)
LOSE
USE IA IE/1 IE/2 IE/3 IE/4 IE/5 IE/6 TF NPAE CA/1 CA/2 CA/3 CA/4 CA/5 CA/6 AN AW

! Para cada estacao do ano
!  - Zera o modelo de apontamento
!  - Para cada canal 
!     - Le os dados e agrega aa lista de observacoes (comando indat indicando um subdataset para cada canal)
!  - Gera arquivo de dados no formato TPoint, incluindo todos os canais (comando outdat)
!  - Calcula o modelo de apontamento (comando fit)
!  - Grava o modelo e respectivos valores de RMS em um arquivo para análise posterior (comando outmex)
!

! PARA PROCESSAMENTO DOS ANOS
! - Substituir (Find & Replace) de acordo com o ano de análise desejado
!
! * EXCLUIR MANUALMENTE AS ESTACOES SEM DADOS:
!   verao 1999 - solsticio de dezembro de 1998 - fora do range do estudo
!   outono 2000 - MarchEq 2000 
!   primavera 2000 - SeptEq 2000
!   primavera 2005 - SeptEq 2005
!   verao 2006 - DecSol 2005
!   verao 2017 - DecSol 2016
!

! VERAO
reset
indat 'indat_files/atual/2016_verao_ch1' 1
append
indat 'indat_files/atual/2016_verao_ch2' 2
append
indat 'indat_files/atual/2016_verao_ch3' 3
append
indat 'indat_files/atual/2016_verao_ch4' 4
append
indat 'indat_files/atual/2016_verao_ch5' 5
append
indat 'indat_files/atual/2016_verao_ch6' 6
outdat 'outdat_files/atual/2016_verao'
fit
outmex 'outmex_files/atual/tpmex_2016_verao'

! OUTONO
reset
indat 'indat_files/atual/2016_outono_ch1' 1
append
indat 'indat_files/atual/2016_outono_ch2' 2
append
indat 'indat_files/atual/2016_outono_ch3' 3
append
indat 'indat_files/atual/2016_outono_ch4' 4
append
indat 'indat_files/atual/2016_outono_ch5' 5
append
indat 'indat_files/atual/2016_outono_ch6' 6
outdat 'outdat_files/atual/2016_outono'
fit
outmex 'outmex_files/atual/tpmex_2016_outono'

! INVERNO
reset
indat 'indat_files/atual/2016_inverno_ch1' 1
append
indat 'indat_files/atual/2016_inverno_ch2' 2
append
indat 'indat_files/atual/2016_inverno_ch3' 3
append
indat 'indat_files/atual/2016_inverno_ch4' 4
append
indat 'indat_files/atual/2016_inverno_ch5' 5
append
indat 'indat_files/atual/2016_inverno_ch6' 6
outdat 'outdat_files/atual/2016_inverno'
fit
outmex 'outmex_files/atual/tpmex_2016_inverno'

! PRIMAVERA
reset
indat 'indat_files/atual/2016_primavera_ch1' 1
append
indat 'indat_files/atual/2016_primavera_ch2' 2
append
indat 'indat_files/atual/2016_primavera_ch3' 3
append
indat 'indat_files/atual/2016_primavera_ch4' 4
append
indat 'indat_files/atual/2016_primavera_ch5' 5
append
indat 'indat_files/atual/2016_primavera_ch6' 6
outdat 'outdat_files/atual/2016_primavera'
fit
outmex 'outmex_files/atual/tpmex_2016_primavera'

RETURN
